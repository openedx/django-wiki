# Exclude development, test, and documentation folders
prune .github
prune docs
prune tests
prune testproject

# Exclude root level configuration and build files
exclude Makefile
exclude conftest.py
exclude .gitignore
exclude tox.ini
exclude uv.lock
exclude pylintrc
exclude catalog-info.yaml
exclude model_chart_wiki.pdf
exclude CHANGELOG.md
exclude TODO.md

# Exclude test/coverage artifacts
prune htmlcov
global-exclude .coverage
global-exclude coverage.xml
